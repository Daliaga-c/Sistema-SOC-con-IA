        <mxCell id="ctx-46" value="External Software System" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#8C8496;strokeColor=#ffffff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1400" y="980" width="230" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dom" name="2. Diagrama de Dominio">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dom-1" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Arquitectura de Software para la aplicación &quot;SOC-IA: Centro de Operaciones de Seguridad potenciado con IA&quot;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Diagrama de Dominio&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1750" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dom-2" value="Gestión de Ingesta de Eventos (Wazuh)" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=50;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
