        <mxCell id="ctx-34" value="S2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="386" width="28" height="28" as="geometry" />
