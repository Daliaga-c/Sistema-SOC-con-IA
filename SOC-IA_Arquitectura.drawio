        </mxCell>
        <mxCell id="ctx-36" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="536" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ctx-37" value="S6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="536" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ctx-38" value="S5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="536" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ctx-39" value="S7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="970" y="536" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ctx-40" value="&lt;b&gt;Supuestos:&lt;/b&gt;&lt;br&gt;S1. Wazuh centraliza los logs de autenticación (Windows 4624/4625, SSH, VPN, AD).&lt;br&gt;S2. Analistas y líderes SOC acceden por web con SSO + MFA.&lt;br&gt;S3. Los modelos se entrenan offline con datasets del grupo (p. ej. LANL, RBA).&lt;br&gt;S4. La inferencia de anomalías es casi en tiempo real (&amp;lt; 1 min).&lt;br&gt;S5. El chatbot responde con el contexto del incidente (RAG).&lt;br&gt;S6. Las alertas se enriquecen con Threat Intelligence y GeoIP.&lt;br&gt;S7. Las alertas críticas se notifican automáticamente.&lt;br&gt;S8. El feedback del analista (TP/FP) se usa para reentrenar." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ctx-41" value="&lt;b&gt;Problemas:&lt;/b&gt;&lt;br&gt;1. Fatiga de alertas y alto volumen de falsos positivos.&lt;br&gt;2. Reglas estáticas no detectan comportamientos de login nuevos.&lt;br&gt;3. Tiempo de triage elevado (MTTD / MTTR altos).&lt;br&gt;4. Analistas N1 sin contexto ni guía para responder." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="880" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ctx-42" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="880" width="230" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ctx-43" value="Person" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#083F75;strokeColor=#ffffff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1400" y="908" width="230" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ctx-44" value="Software System" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#1061B0;strokeColor=#ffffff;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1400" y="932" width="230" height="24" as="geometry" />
