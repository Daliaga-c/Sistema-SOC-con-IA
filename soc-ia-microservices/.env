# Configuración General del Entorno SOC-IA (Producción)
ENVIRONMENT=production
PORT=8000

# Google Gemini API Key (Motor Primario de IA)
GEMINI_API_KEY=AIzaSyBBlj5yrpFzz5lY6CwFqNVGghXfQ2-LXX0
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local LLM Server (Motor de Respaldo Automático cuando Gemini falla)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Conexión Real con Wazuh SIEM (Manager 55000 & Indexer 9200)
WAZUH_API_HOST=host.docker.internal
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_INDEXER_HOST=host.docker.internal
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword

# Microservicios URLs internas
INGESTION_SERVICE_URL=http://ingestion-service:8001
ML_SERVICE_URL=http://ml-anomaly-detection:8002
ALERTS_SERVICE_URL=http://alerts-incidents-service:8003
COPILOT_SERVICE_URL=http://genai-copilot-service:8004
THREAT_INTEL_URL=http://threat-intelligence-service:8005

# Broker y Feature Store
REDIS_HOST=redis-broker
REDIS_PORT=6379

# Base de Datos Relacional PostgreSQL 15 (Exclusivo - Sin SQLite)
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=soc_secure_password
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=soc_incidents
DATABASE_URL=postgresql+psycopg://soc_admin:soc_secure_password@postgres-db:5432/soc_incidents

# Threat Intelligence en Tiempo Real (AbuseIPDB + GeoIP2 + Live IP-API)
ABUSEIPDB_API_KEY=
GEOLITE2_DB_PATH=/app/GeoLite2-City.mmdb

# Wazuh SIEM Active Response & Auto-Listener
ENABLE_WAZUH_ACTIVE_RESPONSE=true
ENABLE_WAZUH_AUTO_LISTENER=false
WAZUH_ALERTS_LOG=/var/ossec/logs/alerts/alerts.json
