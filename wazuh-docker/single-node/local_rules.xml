<!-- Modify it at your will. -->

<group name="local,syslog,sshd,">

  <!-- Reglas personalizadas para tu proyecto SOC-IA -->
  <rule id="100002" level="5">
    <decoded_as>json</decoded_as>
    <field name="source_system">Portal Web Dummy</field>
    <match>FAILURE</match>
    <description>SOC-IA: Intento de inicio de sesion fallido</description>
  </rule>

  <rule id="100003" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100002</if_matched_sid>
    <description>SOC-IA: Posible ataque de fuerza bruta detectado</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
